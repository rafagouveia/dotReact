<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../../dotnet/src/DotReact.AspNetCore/DotReact.AspNetCore.csproj" />
    <ProjectReference Include="Domain/DotReact.Crud.Domain.csproj" />
    <ProjectReference Include="Application/DotReact.Crud.Application.csproj" />
    <ProjectReference Include="Infrastructure/DotReact.Crud.Infrastructure.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Compile Remove="Domain/**/*.cs;Application/**/*.cs;Infrastructure/**/*.cs" />
    <Compile Include="Application/Contracts/*.cs" />
  </ItemGroup>
</Project>
