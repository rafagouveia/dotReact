<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <DotReactAppRoot>$(MSBuildProjectDirectory)\..\app</DotReactAppRoot>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../../dotnet/src/DotReact.Hosting/DotReact.Hosting.csproj" />
    <ProjectReference Include="../../../dotnet/src/DotReact.AppGenerator/DotReact.AppGenerator.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false" />
    <CompilerVisibleProperty Include="DotReactAppRoot" />
    <Compile Include="../app/**/*.cs" Link="app/%(RecursiveDir)%(Filename)%(Extension)" />
    <ProjectReference Include="Domain/DotReact.Crud.Domain.csproj" />
    <ProjectReference Include="Application/DotReact.Crud.Application.csproj" />
    <ProjectReference Include="Infrastructure/DotReact.Crud.Infrastructure.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Compile Remove="Domain/**/*.cs;Application/**/*.cs;Infrastructure/**/*.cs" />
  </ItemGroup>
</Project>
