<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <DotReactAppRoot>$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)/../app'))</DotReactAppRoot>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../../dotnet/src/DotReact.Hosting/DotReact.Hosting.csproj" />
    <ProjectReference Include="../../../dotnet/src/DotReact.AppGenerator/DotReact.AppGenerator.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false" />
    <CompilerVisibleProperty Include="DotReactAppRoot" />
    <Compile Include="../app/**/*.cs" Link="App/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
