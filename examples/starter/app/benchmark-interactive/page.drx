import { useState } from "react";
import type { BenchmarkInteractivePageProps } from "../../src/contracts";
import { definePage } from "@blackredsolutionsteam/dotreact-client/router";

export default definePage<BenchmarkInteractivePageProps>(function BenchmarkInteractivePage(Model) {
  const [count, setCount] = useState(0);
  return (
    <main>
      <h1>{Model.title}</h1>
      <p>Generated at {Model.generatedAt}</p>
      <button type="button" onClick={() => setCount(value => value + 1)}>Count {count}</button>
      <table>
        <thead><tr><th>ID</th><th>Code</th><th>Amount</th><th>Status</th></tr></thead>
        <tbody>{Model.rows.map(row => (
          <tr key={row.id}>
            <td>{row.id}</td><td>{row.code}</td><td>{row.amount}</td><td>{row.status}</td>
          </tr>
        ))}</tbody>
      </table>
    </main>
  );
});
