# syntax=docker/dockerfile:1.7
FROM node:24-bookworm-slim AS node-base

FROM mcr.microsoft.com/dotnet/sdk:10.0-bookworm-slim AS application-build
COPY --from=node-base /usr/local /usr/local
WORKDIR /src
COPY . .
RUN npm ci
RUN npm run generate && npm run build:client && npm run build:ssr
RUN dotnet restore Server/Server.csproj
RUN dotnet publish Server/Server.csproj -c Release -o /publish --no-restore /p:UseAppHost=false

FROM mcr.microsoft.com/dotnet/aspnet:10.0-bookworm-slim AS runtime
COPY --from=node-base /usr/local /usr/local
WORKDIR /app
COPY --from=application-build /publish ./
COPY --from=application-build /src/dist/client ./wwwroot
COPY --from=application-build /src/dist/server ./frontend/server
COPY --from=application-build /src/vendor/renderer/dist ./renderer
COPY --from=application-build /src/vendor/protocol ./node_modules/@dotreact/protocol
COPY --from=application-build /src/node_modules/react ./node_modules/react
COPY --from=application-build /src/node_modules/react-dom ./node_modules/react-dom
COPY --from=application-build /src/node_modules/scheduler ./node_modules/scheduler

ENV ASPNETCORE_HTTP_PORTS=8080 \
    ASPNETCORE_ENVIRONMENT=Production \
    DOTREACT_RENDERER_URL=http://127.0.0.1:5178 \
    DOTREACT_CLIENT_SCRIPT_SRC=/_dotreact/client.js
EXPOSE 8080
USER $APP_UID
STOPSIGNAL SIGINT
ENTRYPOINT ["dotnet", "Server.dll"]
