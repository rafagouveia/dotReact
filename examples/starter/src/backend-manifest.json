{
  "schemaVersion": 2,
  "pages": [
    {
      "moduleId": "page",
      "pattern": "/",
      "routing": "app",
      "propsType": "DotReact.Starter.HomePageProps"
    },
    {
      "moduleId": "products/[id]/page",
      "pattern": "/products/{id}",
      "routing": "app",
      "propsType": "DotReact.Starter.ProductPageProps"
    },
    {
      "moduleId": "streaming/page",
      "pattern": "/streaming",
      "routing": "app",
      "propsType": "DotReact.Starter.Pages.Streaming.StreamingPageProps"
    }
  ],
  "actions": [
    {
      "id": "demo/increment",
      "exportName": "demoIncrement",
      "requestType": "DotReact.Starter.IncrementDemoRequest",
      "responseType": "DotReact.Starter.IncrementDemoResponse"
    }
  ]
}
