import type { DotReactBoundaryProps } from "@dotreact/vite";
import type { DotReactMetadata } from "@dotreact/vite";

export const metadata: DotReactMetadata = { title: "Erro · DotReact", noIndex: true };

export default function ErrorPage({ statusCode, requestId, message }: DotReactBoundaryProps) {
  return (
    <main className="shell">
      <p className="eyebrow">{statusCode} · DotReact error boundary</p>
      <h1>Não foi possível renderizar esta página</h1>
      <p>{message ?? "Tente novamente em instantes."}</p>
      <p className="muted">Request ID: {requestId}</p>
      <a href="/">Voltar ao início</a>
    </main>
  );
}
