import type { ProductPageProps } from "../../../contracts";
import type { DotReactMetadataResolver } from "@dotreact/vite";

export const metadata: DotReactMetadataResolver<ProductPageProps> = props => ({
  title: `${props.name} · DotReact`,
  description: `Produto dinâmico ${props.id} carregado pelo backend C#.`
});

export default function ProductPage({ id, name, loadedBy }: ProductPageProps) {
  return (
    <main className="shell">
      <p className="eyebrow">Rota dinâmica SSR</p>
      <h1>{name}</h1>
      <p>O segmento <code>{id}</code> foi convertido e carregado pelo C#.</p>
      <p className="muted">{loadedBy}</p>
      <a href="/">Voltar</a>
    </main>
  );
}
