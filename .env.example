# Optional shared cache/backplane. Azure deployments should source this from a
# secret store or managed service configuration, never commit a real value.
DOTREACT_REDIS_CONNECTION=

# Stable identifier used to separate cached SSR output between releases.
DOTREACT_BUILD_ID=

# Optional OpenTelemetry collector endpoint, for example an Azure Monitor
# OpenTelemetry distribution or an OTLP-compatible collector.
OTEL_EXPORTER_OTLP_ENDPOINT=
