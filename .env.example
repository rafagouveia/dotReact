# Optional shared cache/backplane. Azure deployments should source this from a
# secret store or managed service configuration, never commit a real value.
DOTREACT_REDIS_CONNECTION=

# Optional safe ASCII namespace. By default DotReact derives one from the
# application name so applications sharing Redis cannot affect each other.
DOTREACT_REDIS_KEY_PREFIX=

# Stable identifier used to separate cached SSR output between releases.
DOTREACT_BUILD_ID=

# Optional OpenTelemetry collector endpoint, for example an Azure Monitor
# OpenTelemetry distribution or an OTLP-compatible collector.
OTEL_EXPORTER_OTLP_ENDPOINT=

# Optional external login example. Keep the real secret in Secret Manager,
# Azure Key Vault, or the deployment platform's secret store.
Authentication__Google__ClientId=
Authentication__Google__ClientSecret=
