{
  "name": "dotreact-vscode",
  "displayName": "%extension.displayName%",
  "description": "%extension.description%",
  "version": "0.2.0",
  "publisher": "rafagouveia",
  "license": "MPL-2.0",
  "icon": "assets/dotreact-extension-icon.png",
  "pricing": "Free",
  "homepage": "https://github.com/rafagouveia/dotReact#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/rafagouveia/dotReact.git",
    "directory": "editors/vscode-dotreact"
  },
  "bugs": {
    "url": "https://github.com/rafagouveia/dotReact/issues"
  },
  "main": "./extension.cjs",
  "scripts": {
    "vscode:prepublish": "npm run build && npm test",
    "build": "node --check extension.cjs && node --check core.cjs",
    "typecheck": "node --check extension.cjs && node --check core.cjs",
    "test": "node --test core.test.cjs",
    "test:integration": "node integration/run.cjs",
    "package:vsix": "vsce package --pre-release --no-dependencies --out dotreact-vscode.vsix",
    "package:vsix:stable": "vsce package --no-dependencies --out dotreact-vscode.vsix",
    "publish:pre-release": "vsce publish --azure-credential --pre-release --no-dependencies",
    "publish:stable": "vsce publish --azure-credential --no-dependencies"
  },
  "engines": {
    "vscode": "^1.96.0"
  },
  "extensionKind": ["workspace"],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "%capabilities.untrustedWorkspaces%",
      "restrictedConfigurations": ["dotreact.checkOnSave"]
    },
    "virtualWorkspaces": {
      "supported": false,
      "description": "%capabilities.virtualWorkspaces%"
    }
  },
  "categories": ["Programming Languages", "Linters", "Other"],
  "keywords": ["dotreact", "drx", "react", "csharp", "aspnet", "ssr", "typescript"],
  "galleryBanner": {
    "color": "#071a3d",
    "theme": "dark"
  },
  "contributes": {
    "commands": [
      { "command": "dotreact.openBackendLoader", "title": "%command.openBackendLoader%", "enablement": "resourceExtname == .drx" },
      { "command": "dotreact.checkProject", "title": "%command.checkProject%" },
      { "command": "dotreact.showOutput", "title": "%command.showOutput%" },
      { "command": "dotreact.openDocumentation", "title": "%command.openDocumentation%" }
    ],
    "configuration": {
      "title": "%configuration.title%",
      "properties": {
        "dotreact.checkOnSave": {
          "type": "boolean",
          "default": true,
          "scope": "resource",
          "description": "%configuration.checkOnSave%"
        },
        "dotreact.validation.debounceMs": {
          "type": "number",
          "default": 350,
          "minimum": 100,
          "maximum": 2000,
          "scope": "resource",
          "description": "%configuration.validation.debounceMs%"
        }
      }
    },
    "languages": [
      {
        "id": "typescriptreact",
        "extensions": [".drx"],
        "aliases": ["DotReact", "drx"]
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "dotreact.checkProject",
          "when": "resourceExtname == .drx",
          "group": "navigation@20"
        }
      ]
    }
  },
  "devDependencies": {
    "@vscode/test-electron": "3.1.0",
    "@vscode/vsce": "3.9.2"
  }
}
