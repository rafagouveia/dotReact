* text=auto eol=lf

# Windows command files require CRLF when executed directly.
*.bat text eol=crlf
*.cmd text eol=crlf

# Treat DotReact views as TypeScript/React for diffs.
*.drx text eol=lf diff=typescript
*.cs text eol=lf diff=csharp
*.csproj text eol=lf
*.props text eol=lf
*.targets text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

# Binary assets must never be line-ending normalized.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary
*.zip binary
*.dll binary
*.pdb binary

