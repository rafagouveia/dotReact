{
  "name": "@rafagouveia/dotreact-vite",
  "version": "0.1.4",
  "description": "Vite plugin, App Router compiler and DRX checker for DotReact.",
  "license": "PolyForm-Noncommercial-1.0.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rafagouveia/dotReact.git",
    "directory": "packages/vite"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "restricted"
  },
  "files": [
    "dist",
    "scripts",
    "!dist/**/*.test.*"
  ],
  "type": "module",
  "exports": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "dotreact-check": "./scripts/dotreact-check.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test dist/index.test.js"
  },
  "dependencies": {
    "@rafagouveia/dotreact-font": "0.1.4",
    "@vitejs/plugin-react": "6.0.4",
    "typescript": "7.0.2",
    "vite": "8.1.5"
  },
  "devDependencies": {
    "@types/node": "24.13.3"
  }
}
