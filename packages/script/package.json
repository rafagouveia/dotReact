{
  "name": "@rafagouveia/dotreact-script",
  "version": "0.1.4",
  "description": "Controlled script loading strategies for DotReact.",
  "license": "MPL-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rafagouveia/dotReact.git",
    "directory": "packages/script"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "restricted"
  },
  "files": [
    "dist",
    "!dist/**/*.test.*"
  ],
  "type": "module",
  "exports": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test dist/index.test.js"
  },
  "dependencies": {
    "@rafagouveia/dotreact-client": "0.1.4"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "typescript": "7.0.2"
  }
}
