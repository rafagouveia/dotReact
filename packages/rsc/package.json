{
  "name": "@rafagouveia/dotreact-rsc",
  "version": "0.1.4-experimental.0",
  "description": "Experimental React Server Components integration for DotReact.",
  "license": "MPL-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rafagouveia/dotReact.git",
    "directory": "packages/rsc"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "restricted"
  },
  "files": [
    "dist",
    "!dist/**/*.test.*"
  ],
  "type": "module",
  "exports": {
    ".": "./dist/index.js",
    "./ppr": "./dist/ppr.js",
    "./rsc": "./dist/rsc-runtime.js",
    "./ssr": "./dist/ssr-runtime.js",
    "./browser": "./dist/browser-runtime.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test dist/*.test.js"
  },
  "dependencies": {
    "@vitejs/plugin-rsc": "0.5.29"
  },
  "peerDependencies": {
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-server-dom-webpack": "19.3.0",
    "vite": "8.1.5"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-server-dom-webpack": "19.3.0",
    "typescript": "7.0.2",
    "vite": "8.1.5"
  }
}
