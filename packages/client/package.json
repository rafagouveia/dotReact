{
  "name": "@rafagouveia/dotreact-client",
  "version": "0.1.4",
  "description": "Hydration, navigation and Server Action client runtime for DotReact.",
  "license": "MPL-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rafagouveia/dotReact.git",
    "directory": "packages/client"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "restricted"
  },
  "files": [
    "dist",
    "!dist/**/*.test.*"
  ],
  "type": "module",
  "exports": {
    ".": "./dist/index.js",
    "./boundaries": "./dist/boundaries.js",
    "./bootstrap": "./dist/bootstrap.js",
    "./router": "./dist/router.js",
    "./errors": "./dist/errors.js",
    "./vitals": "./dist/vitals.js"
  },
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test dist/index.test.js dist/router.test.js dist/navigation-cache.test.js dist/errors.test.js dist/vitals.test.js"
  },
  "peerDependencies": {
    "react": ">=19.2.0",
    "react-dom": ">=19.2.0"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "typescript": "7.0.2"
  }
}
