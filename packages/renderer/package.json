{
  "name": "@rafagouveia/dotreact-renderer",
  "version": "0.1.3",
  "description": "Private Node renderer runtime used by DotReact ASP.NET Core hosts.",
  "license": "MPL-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rafagouveia/dotReact.git",
    "directory": "packages/renderer"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "restricted"
  },
  "files": [
    "dist",
    "!dist/**/*.test.*"
  ],
  "type": "module",
  "bin": {
    "dotreact-renderer": "./dist/server.js"
  },
  "exports": {
    ".": "./dist/server.js",
    "./react": "./dist/react-runtime.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test dist/*.test.js",
    "start": "node dist/server.js",
    "start:production": "node dist/production-server.js"
  },
  "dependencies": {
    "@rafagouveia/dotreact-client": "0.1.3",
    "@rafagouveia/dotreact-protocol": "0.1.3",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "vite": "8.1.5"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "typescript": "7.0.2"
  }
}
