{
  "name": "@rafagouveia/dotreact-docs",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5100",
    "validate:content": "node scripts/validate-content.mjs",
    "validate:translations": "node scripts/generate-english-catalog.mjs --check",
    "validate:pages": "node scripts/validate-pages-build.mjs",
    "build": "npm run validate:content && npm run validate:translations && tsc -b && vite build",
    "typecheck": "npm run validate:content && npm run validate:translations && tsc -b --pretty false"
  },
  "dependencies": {
    "@vitejs/plugin-react": "6.0.3",
    "prism-react-renderer": "2.4.0",
    "prismjs": "1.30.0",
    "react": "19.2.8",
    "react-dom": "19.2.7",
    "typescript": "7.0.2",
    "vite": "8.1.5"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "tailwindcss": "4.3.3"
  }
}
